datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                    String                 @id @default(cuid())
  email                 String                 @unique
  name                  String
  passwordHash          String
  role                  String                 @default("ATHLETE") // SUPER_ADMIN, COACH, ATHLETE, CLUB_ADMIN, SPONSORSHIP_COMMITTEE
  phone                 String?
  avatarUrl             String?
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  athlete               Athlete?
  coachAssignments      CoachAssignment[]      @relation("CoachUser")
  sponsorshipDecisions  SponsorshipDecision[]  @relation("DecisionMaker")
  auditLogs             AuditLog[]
  notifications         Notification[]
  coachReviews          CoachReview[]          @relation("CoachAuthor")
  paymentsVerified      MembershipPayment[]    @relation("PaymentVerifier")
}

model Athlete {
  id                    String                 @id @default(cuid())
  userId                String?                @unique
  athleteNumber         String                 @unique
  firstName             String
  lastName              String
  preferredName         String?
  dateOfBirth           DateTime
  gender                String                 // MALE, FEMALE, OTHER
  contactEmail          String
  contactPhone          String?
  membershipStartDate   DateTime
  membershipStatus      String                 @default("ACTIVE") // ACTIVE, PENDING_RENEWAL, LAPSED, LIFE_MEMBER, SUSPENDED
  membershipCategory    String                 @default("SENIOR_RUNNER") // SENIOR_RUNNER, SENIOR_WALKER, MASTER_RUNNER, MASTER_WALKER, JUNIOR_RUNNER, JUNIOR_WALKER, SOCIAL_WALKER, LIFE_MEMBER
  disciplineCategory    String                 @default("RUNNER") // RUNNER, WALKER, DUAL
  asaLicenseNumber      String?                // Athletics South Africa (ASA) License Number
  membershipExpiry      DateTime?              // End of season renewal date (e.g. 2026-12-31)
  membershipFeeStatus   String                 @default("PAID") // PAID, PENDING, EXEMPT, SUBSIDIZED
  athleteStatus         String                 @default("DEVELOPMENT") // DEVELOPMENT, PERFORMANCE, ELITE, RECREATIONAL
  primaryDiscipline     String                 @default("MARATHON") // 5K, 10K, 21K, MARATHON, ULTRA_50K, ULTRA_56K, ULTRA_90K, TRAIL, CROSS_COUNTRY, TRACK, WALKING, RACE_WALK, FITNESS_WALK
  avatarUrl             String?
  emergencyContact      String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  user                  User?                  @relation(fields: [userId], references: [id])
  coachAssignments      CoachAssignment[]
  goals                 AthleteGoal[]
  trainingActivities    TrainingActivity[]
  wellnessEntries       WellnessEntry[]
  raceResults           RaceResult[]
  performanceScores     PerformanceScore[]
  clubAttendances       ClubAttendance[]
  volunteerContributions VolunteerContribution[]
  loyaltyExemptions     LoyaltyExemption[]
  sponsorships          Sponsorship[]
  sponsorshipTransactions SponsorshipTransaction[]
  sponsorshipConditions SponsorshipCondition[]
  sponsorshipDecisions  SponsorshipDecision[]
  obligations           AthleteObligation[]
  aiRecommendations     AIRecommendation[]
  coachReviews          CoachReview[]
  medallions            AthleteMedallion[]
  payments              MembershipPayment[]
  eventRegistrations    EventRegistration[]
  seasonArchives        SeasonArchive[]
}

model CoachAssignment {
  id          String    @id @default(cuid())
  coachId     String
  athleteId   String
  assignedDate DateTime @default(now())
  status      String    @default("ACTIVE") // ACTIVE, PREVIOUS
  notes       String?

  coach       User      @relation("CoachUser", fields: [coachId], references: [id])
  athlete     Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
}

model AthleteGoal {
  id                   String    @id @default(cuid())
  athleteId            String
  targetRaceId         String?
  targetRaceName       String
  targetDate           DateTime
  targetTimeSeconds    Int       // e.g. 10800 for 3:00:00
  targetQualification  String?   // e.g. "Sub 3:00 Comrades Bill Rowan Qualifier"
  targetCategory       String?
  priority             String    @default("HIGH") // HIGH, MEDIUM, LOW
  coachComments        String?
  status               String    @default("IN_PROGRESS") // IN_PROGRESS, ACHIEVED, MISSED, CANCELLED
  createdAt            DateTime  @default(now())

  athlete              Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
}

model TrainingActivity {
  id                   String          @id @default(cuid())
  athleteId            String
  date                 DateTime
  activityType         String          @default("RUN") // RUN, TRAIL_RUN, TRACK_INTERVALS, TIME_TRIAL, RECOVERY_RUN, CROSS_TRAINING
  distanceKm           Float
  durationSeconds      Int
  averagePaceSeconds   Int             // seconds per km, e.g. 270 = 4:30/km
  fastestPaceSeconds   Int?
  elevationGain        Int             @default(0)
  elevationLoss        Int             @default(0)
  avgHeartRate         Int?
  maxHeartRate         Int?
  cadence              Int?
  runningPower         Int?
  strideLength         Float?
  workoutType          String          @default("EASY") // EASY, INTERVALS, TEMPO, LONG_RUN, RECOVERY, RACE_SIMULATION
  surface              String          @default("ROAD") // ROAD, TRACK, TRAIL, TREADMILL, MIXED
  route                String?
  sessionRpe           Int?            // 1 to 10
  athleteNotes         String?
  coachNotes           String?
  source               String          @default("MANUAL") // MANUAL, CSV, GARMIN_EXPORT, STRAVA_EXPORT
  isLongRun            Boolean         @default(false)
  createdAt            DateTime        @default(now())

  athlete              Athlete         @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  splits               TrainingSplit[]
}

model TrainingSplit {
  id                   String          @id @default(cuid())
  activityId           String
  splitNumber          Int
  distanceKm           Float
  durationSeconds      Int
  paceSeconds          Int
  avgHeartRate         Int?
  elevationChange      Int?

  activity             TrainingActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
}

model WellnessEntry {
  id                   String    @id @default(cuid())
  athleteId            String
  date                 DateTime
  restingHeartRate     Int?
  hrv                  Int?      // ms (RMSSD)
  sleepDurationHours   Float?
  sleepQuality         Int?      // 1 to 5
  muscleSoreness       Int?      // 1 to 5
  fatigueLevel         Int?      // 1 to 5
  perceivedRecovery    Int?      // 1 to 5
  motivation           Int?      // 1 to 5
  stressLevel          Int?      // 1 to 5
  sessionRpe           Int?      // 1 to 10
  notes                String?
  createdAt            DateTime  @default(now())

  athlete              Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
}

model Race {
  id                   String        @id @default(cuid())
  name                 String
  location             String
  country              String        @default("South Africa")
  defaultDistanceKm    Float
  elevationProfile     String?       // "FLAT", "HILLY", "EXTREME_CLIMB", "ROLLING"
  surface              String        @default("ROAD") // ROAD, TRAIL, TRACK, CROSS_COUNTRY
  raceCategory         String        @default("MARATHON") // ROAD_5K, ROAD_10K, ROAD_15K, HALF_MARATHON, MARATHON, ULTRA_50K, ULTRA_56K, ULTRA_90K, TRAIL, TRACK
  difficultyRating     Int           @default(3) // 1 to 5
  strategicImportance  String        @default("HIGH") // HIGH, MEDIUM, LOW
  createdAt            DateTime      @default(now())

  editions             RaceEdition[]
}

model RaceEdition {
  id                           String        @id @default(cuid())
  raceId                       String
  year                         Int
  date                         DateTime
  qualificationWindowStart     DateTime?
  qualificationWindowEnd       DateTime?
  qualificationStandardSeconds Int?          // e.g. 17940 for Comrades 4:59:00 qualifier standard
  cutoffTimeSeconds            Int?          // e.g. 43200 for Comrades 12:00:00
  expectedDifficulty           Int           @default(3)
  notes                        String?

  race                         Race          @relation(fields: [raceId], references: [id], onDelete: Cascade)
  results                      RaceResult[]
  transactions                 SponsorshipTransaction[]
  eventRegistrations           EventRegistration[]
  eventLogistics               EventLogistics?
}

model RaceResult {
  id                    String       @id @default(cuid())
  athleteId             String
  raceEditionId         String?
  raceName              String
  date                  DateTime
  distanceKm            Float
  officialTimeSeconds   Int
  overallPosition       Int?
  genderPosition        Int?
  categoryPosition      Int?
  category              String?      // OPEN, 40-49, 50-59, etc.
  resultStatus          String       @default("FINISHED") // FINISHED, DNF, DNS, DQ
  source                String       @default("OFFICIAL_TIMING") // OFFICIAL_TIMING, ADMIN_MANUAL, SELF_REPORTED
  verificationStatus    String       @default("VERIFIED") // VERIFIED, PENDING_VERIFICATION, REJECTED
  isPersonalBest        Boolean      @default(false)
  isClubRecord          Boolean      @default(false)
  qualificationAchieved String?
  raceConditions        String?      // HOT, COOL, RAIN, HIGH_WIND, IDEAL
  elevation             Int?
  firstHalfPaceSeconds  Int?         // for durability calculation
  secondHalfPaceSeconds Int?
  bibNumber             String?      // Official bib / race number
  certificateUrl        String?      // Uploaded timing certificate or photo proof URL
  officialResultsUrl    String?      // Official online results portal link
  notes                 String?
  createdAt             DateTime     @default(now())

  athlete               Athlete      @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  raceEdition           RaceEdition? @relation(fields: [raceEditionId], references: [id])
}

model PerformanceScore {
  id                       String    @id @default(cuid())
  athleteId                String
  calculationDate          DateTime  @default(now())
  verifiedPerformanceScore Float     // 0 - 100
  improvementScore         Float     // 0 - 100
  targetCapabilityScore    Float     // 0 - 100
  reliabilityScore         Float     // 0 - 100
  totalPerformanceIndex    Float     // 0 - 100
  periodMonths             Int       @default(12)
  breakdownJson            String    // JSON breakdown for transparency

  athlete                  Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
}

model ClubActivity {
  id                   String                  @id @default(cuid())
  title                String
  date                 DateTime
  activityType         String                  // WEEKLY_RUN, TIME_TRIAL, TRAINING_SESSION, VOLUNTEER_EVENT, WATER_POINT, CLUB_MEETING, SOCIAL_EVENT, CLINIC
  location             String
  expectedParticipants Int                     @default(30)
  pointsValue          Int                     @default(10)
  isMandatory          Boolean                 @default(false)
  notes                String?
  createdAt            DateTime                @default(now())

  attendances          ClubAttendance[]
  volunteers           VolunteerContribution[]
}

model ClubAttendance {
  id                   String        @id @default(cuid())
  clubActivityId       String
  athleteId            String
  attended             Boolean       @default(true)
  checkInTime          DateTime?
  recordedBy           String?
  notes                String?
  createdAt            DateTime      @default(now())

  clubActivity         ClubActivity  @relation(fields: [clubActivityId], references: [id], onDelete: Cascade)
  athlete              Athlete       @relation(fields: [athleteId], references: [id], onDelete: Cascade)
}

model VolunteerContribution {
  id                   String        @id @default(cuid())
  clubActivityId       String
  athleteId            String
  roleName             String        // WATER_POINT_MARSHAL, REGISTRATION_DESK, COURSE_SETUP, TIMING_ASSISTANT, PACER
  hoursServed          Float         @default(2.0)
  pointsAwarded        Int           @default(20)
  notes                String?
  createdAt            DateTime      @default(now())

  clubActivity         ClubActivity  @relation(fields: [clubActivityId], references: [id], onDelete: Cascade)
  athlete              Athlete       @relation(fields: [athleteId], references: [id], onDelete: Cascade)
}

model LoyaltyExemption {
  id                               String    @id @default(cuid())
  athleteId                        String
  reason                           String    // WORK, STUDIES, RELOCATION, INJURY, NATIONAL_DUTY, FAMILY
  startDate                        DateTime
  endDate                          DateTime
  expectedAttendanceReductionRatio Float     @default(1.0) // 1.0 means 100% exempt from denominator
  approvedBy                       String
  status                           String    @default("APPROVED") // APPROVED, REJECTED, EXPIRED
  notes                            String?
  createdAt                        DateTime  @default(now())

  athlete                          Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
}

model Sponsorship {
  id                   String                   @id @default(cuid())
  athleteId            String
  currentTier          String                   @default("DEVELOPMENT") // ELITE, PERFORMANCE, DEVELOPMENT, MAINTAIN, CONDITIONAL, REVIEW, REDUCE, NON_SPONSORED
  startDate            DateTime                 @default(now())
  endDate              DateTime?
  status               String                   @default("ACTIVE") // ACTIVE, UNDER_REVIEW, SUSPENDED, TERMINATED
  notes                String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  athlete              Athlete                  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  transactions         SponsorshipTransaction[]
  conditions           SponsorshipCondition[]
  decisions            SponsorshipDecision[]
}

model SponsorshipTransaction {
  id                   String       @id @default(cuid())
  sponsorshipId        String?
  athleteId            String
  transactionDate      DateTime     @default(now())
  supportType          String       // CASH_STIPEND, RACE_ENTRY, TRANSPORT, FLIGHT, ACCOMMODATION, CLOTHING, SHOES, EQUIPMENT, NUTRITION, COACHING_SUBSIDY, PHYSIO_MEDICAL
  amount               Float        // in ZAR
  currency             String       @default("ZAR")
  raceEditionId        String?
  fundingSource        String       @default("CLUB_CORE_BUDGET")
  approvedBy           String
  notes                String?
  createdAt            DateTime     @default(now())

  sponsorship          Sponsorship? @relation(fields: [sponsorshipId], references: [id])
  athlete              Athlete      @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  raceEdition          RaceEdition? @relation(fields: [raceEditionId], references: [id])
}

model SponsorshipCondition {
  id                   String       @id @default(cuid())
  sponsorshipId        String
  athleteId            String
  conditionText        String
  metricType           String       // ATTENDANCE_PERCENT, VOLUNTEER_COUNT, TARGET_RACE_REPRESENTATION, PERFORMANCE_STANDARD, OBLIGATION_REPORT
  targetValue          Float
  currentValue         Float        @default(0)
  deadline             DateTime
  status               String       @default("PENDING") // PENDING, MET, BREACHED, WAIVED
  responsiblePerson    String?
  evidenceNotes        String?
  reviewDate           DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  sponsorship          Sponsorship  @relation(fields: [sponsorshipId], references: [id], onDelete: Cascade)
  athlete              Athlete      @relation(fields: [athleteId], references: [id], onDelete: Cascade)
}

model SponsorshipDecision {
  id                   String       @id @default(cuid())
  sponsorshipId        String?
  athleteId            String
  decisionDate         DateTime     @default(now())
  decidedById          String
  recommendedTier      String
  actualTier           String
  isOverridden         Boolean      @default(false)
  overrideReason       String?
  committeeNotes       String?
  reviewDate           DateTime?
  createdAt            DateTime     @default(now())

  sponsorship          Sponsorship? @relation(fields: [sponsorshipId], references: [id])
  athlete              Athlete      @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  decidedBy            User         @relation("DecisionMaker", fields: [decidedById], references: [id])
}

model AthleteObligation {
  id                   String       @id @default(cuid())
  athleteId            String
  title                String
  description          String
  deadline             DateTime
  status               String       @default("PENDING") // PENDING, COMPLETED, OVERDUE, WAIVED
  verifiedBy           String?
  notes                String?
  createdAt            DateTime     @default(now())

  athlete              Athlete      @relation(fields: [athleteId], references: [id], onDelete: Cascade)
}

model AIRecommendation {
  id                     String    @id @default(cuid())
  athleteId              String
  recommendationType     String    // COACHING_PACING, COACHING_VOLUME, COACHING_RECOVERY, SPONSORSHIP_RECIPROCITY_ALERT, TALENT_IDENTIFICATION, PERFORMANCE_DECLINE
  title                  String
  summary                String
  factualDataJson        String    // Strict JSON of factual evidence
  aiInterpretation       String    // AI analysis narrative
  status                 String    @default("PROPOSED") // PROPOSED, APPROVED_BY_COACH, MODIFIED_BY_COACH, REJECTED_BY_COACH, COMPLETED
  coachFeedback          String?
  modifiedRecommendation String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  athlete                Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
}

model CoachReview {
  id                   String    @id @default(cuid())
  coachId              String
  athleteId            String
  reviewDate           DateTime  @default(now())
  readinessAssessment  String    // HIGH, NORMAL, CAUTION, INSUFFICIENT_DATA
  technicalNotes       String
  goalProgress         String
  recommendations      String?
  createdAt            DateTime  @default(now())

  coach                User      @relation("CoachAuthor", fields: [coachId], references: [id])
  athlete              Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
}

model SystemConfiguration {
  id                   String    @id @default(cuid())
  configKey            String    @unique
  configValueJson      String
  description          String?
  updatedBy            String?
  updatedAt            DateTime  @updatedAt
}

model AuditLog {
  id                   String    @id @default(cuid())
  userId               String?
  action               String    // CREATE, UPDATE, DELETE, OVERRIDE, APPROVE, REJECT, IMPORT, EXPORT
  entityType           String    // ATHLETE, RACE_RESULT, SPONSORSHIP, EXEMPTION, CONDITION, CONFIG
  entityId             String?
  oldValuesJson        String?
  newValuesJson        String?
  ipAddress            String?
  timestamp            DateTime  @default(now())

  user                 User?     @relation(fields: [userId], references: [id])
}

model Notification {
  id                   String    @id @default(cuid())
  userId               String
  title                String
  message              String
  notificationType     String    // SPONSORSHIP_REVIEW, CONDITION_ALERT, RACE_APPROACHING, RESULT_VERIFICATION, PERFORMANCE_DECLINE, IMPROVEMENT
  isRead               Boolean   @default(false)
  linkUrl              String?
  createdAt            DateTime  @default(now())

  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AthleteMedallion {
  id                  String    @id @default(cuid())
  athleteId           String
  awardType           String    // ATHLETE_OF_THE_MONTH, ATHLETE_OF_THE_YEAR
  trackCategory       String    // COMPETITIVE, HEALTH_WELLNESS
  period              String    // e.g., "March 2026", "2025/2026 Season"
  month               Int?      // 1–12
  year                Int       // e.g., 2026
  title               String
  citation            String
  conferredBy         String    // e.g. "Club Executive Committee & Head Coach"
  criteriaMetricsJson String    // JSON string of factual proof (API, PDI, CCLI, PBs, Attendance)
  badgeVariant        String    // GOLD_CHAMPION, PLATINUM_ELITE, EMERALD_WELLNESS
  createdAt           DateTime  @default(now())

  athlete             Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
}

model MembershipPayment {
  id               String    @id @default(cuid())
  athleteId        String
  seasonYear       Int
  amount           Float
  currency         String    @default("ZAR")
  paymentMethod    String    @default("EFT") // EFT, CASH, SNAPSCAN, CARD
  receiptNumber    String?   @unique
  referenceNumber  String?
  popUrl           String?
  popFileName      String?
  status           String    @default("PENDING_VERIFICATION") // PENDING_VERIFICATION, VERIFIED, REJECTED
  paymentDate      DateTime  @default(now())
  verifiedById     String?
  verifiedAt       DateTime?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  athlete          Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  verifiedBy       User?     @relation("PaymentVerifier", fields: [verifiedById], references: [id])
}

model EventRegistration {
  id                   String       @id @default(cuid())
  raceEditionId        String
  athleteId            String
  registrationDate     DateTime     @default(now())
  status               String       @default("REGISTERED") // REGISTERED, CONFIRMED, WAITLIST, WITHDRAWN
  targetDistanceKm     Float?
  targetTimeSeconds    Int?
  transportOption      String       @default("NONE") // NONE, BUS_SEAT, CARPOOL, SELF_DRIVE
  busSeatNumber        String?
  accommodationOption  String       @default("NONE") // NONE, HOTEL_SHARED, HOTEL_SINGLE
  roomNumber           String?
  dietaryRequirements  String?
  emergencyContact     String?
  bibNumber            String?
  feeAmount            Float        @default(0)
  feeStatus            String       @default("PENDING") // PENDING, PAID, SUBSIDIZED, WAIVED
  paymentReference     String?
  notes                String?
  createdAt            DateTime     @default(now())

  raceEdition          RaceEdition  @relation(fields: [raceEditionId], references: [id], onDelete: Cascade)
  athlete              Athlete      @relation(fields: [athleteId], references: [id], onDelete: Cascade)
}

model EventLogistics {
  id                   String       @id @default(cuid())
  raceEditionId        String       @unique
  busEnabled           Boolean      @default(false)
  busDepartureLocation String?
  busDepartureTime     DateTime?
  busCapacity          Int          @default(50)
  busCostPerPerson     Float        @default(0)
  hotelEnabled         Boolean      @default(false)
  hotelName            String?
  hotelAddress         String?
  hotelCheckIn         DateTime?
  hotelCheckOut        DateTime?
  hotelTotalRooms      Int          @default(10)
  hotelCostPerRoom     Float        @default(0)
  volunteerRosterJson  String?      // Station assignments, marshal list JSON
  notes                String?
  updatedAt            DateTime     @updatedAt

  raceEdition          RaceEdition  @relation(fields: [raceEditionId], references: [id], onDelete: Cascade)
}

model SeasonArchive {
  id                  String    @id @default(cuid())
  seasonYear          Int
  athleteId           String
  totalRaces          Int       @default(0)
  totalVolunteered    Int       @default(0)
  totalAttendance     Int       @default(0)
  ccliScore           Float     @default(0)
  apiScore            Float     @default(0)
  cssScore            Float     @default(0)
  membershipCategory  String
  membershipFeeStatus String
  snapshotJson        String    // JSON dump of metrics
  archivedAt          DateTime  @default(now())

  athlete             Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
}

