# Super Eagles Athlete Management System - Example Environment Configuration

# Database Connection (SQLite local file or PostgreSQL URL)
DATABASE_URL="file:./dev.db"

# JWT Secret for Auth Cookies
JWT_SECRET="replace-with-a-cryptographically-random-secret-of-32-or-more-characters"

# Optional local-only evaluator feature. Never enable this in production.
ENABLE_DEMO_ROLE_SWITCH="false"

# Optional External AI Keys (Deterministic analytics and AI recommendations work 100% without keys)
# OPENAI_API_KEY="sk-..."
# GEMINI_API_KEY="..."

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional override. Leave unset to infer HTTP/HTTPS from the request or public URL.
# SESSION_COOKIE_SECURE="true"
