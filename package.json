{
  "name": "super-eagles-ams",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node ./node_modules/next/dist/bin/next dev -H 0.0.0.0 -p 3000",
    "build": "node ./node_modules/next/dist/bin/next build",
    "build:postgres": "node ./node_modules/prisma/build/index.js generate --schema=prisma/schema.postgresql.prisma && node ./node_modules/next/dist/bin/next build",
    "start": "node ./node_modules/next/dist/bin/next start -H 0.0.0.0 -p 3000",
    "lint": "node ./node_modules/typescript/bin/tsc --noEmit",
    "prisma:generate": "node ./node_modules/prisma/build/index.js generate",
    "prisma:push": "node ./node_modules/prisma/build/index.js db push",
    "prisma:seed": "node scripts/seed.mjs",
    "bootstrap:admin": "node scripts/bootstrap_admin.mjs",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node ./node_modules/vitest/vitest.mjs",
    "test:workflows": "node ./node_modules/vitest/vitest.mjs run src/lib/analytics/__tests__/full_workflow_simulation.test.ts",
    "test:burn-in": "node ./node_modules/vitest/vitest.mjs run src/lib/analytics/__tests__/burn_in_4d_stress.test.ts src/lib/analytics/__tests__/full_workflow_simulation.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.4.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "cookie": "^1.0.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.475.0",
    "next": "^16.3.4",
    "papaparse": "^5.5.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie": "^0.6.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.13.0",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "prisma": "^6.4.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  }
}
